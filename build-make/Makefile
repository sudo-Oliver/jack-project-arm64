# Build rule for target.
test-event: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 test-event
.PHONY : test-event

# fast build rule for target.
test-event/fast:
	$(MAKE) $(MAKESILENT) -f third-party/curl/tests/CMakeFiles/test-event.dir/build.make third-party/curl/tests/CMakeFiles/test-event.dir/build
.PHONY : test-event/fast

